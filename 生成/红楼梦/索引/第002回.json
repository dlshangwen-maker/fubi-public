    },
    {
      "段": "2.4",
      "事": "娇杏一年后生一子，又半载雨村嫡配病故，娇杏被扶为正室"
    },
    {
      "段": "2.5",
      "事": "交代雨村当年进京中进士、升任知县，后因贪酷被参革职，遂游览天下，来到扬州"
    },
    {
      "段": "2.6",
      "事": "交代林如海的出身家世，及其独女黛玉"
    },
    {
      "段": "2.7",
      "事": "雨村经旧友推荐，进林家衙门为黛玉作西席"
    },
    {
      "段": "2.8",
      "事": "黛玉之母贾氏病故，黛玉哀痛病发停学"
    },
    {
      "段": "2.8",
      "事": "雨村郊游至智通寺，见对联，入内问老僧，老僧所答非所问"
    },
    {
      "段": "2.9",
      "事": "雨村在村肆偶遇旧识冷子兴，同席饮酒叙旧"
    },
    {
      "段": "2.10",
      "事": "子兴说起荣国贾府，称宁荣二府已萧索，儿孙一代不如一代"
    },
    {
      "段": "2.11",
      "事": "子兴讲述宁荣二府世系，提到贾政之子生时口衔五彩玉"
    },
    {
      "段": "2.12",
      "事": "子兴讲宝玉抓周只抓脂粉钗环及“女儿是水做的骨肉”之语，雨村正色反驳"
    },
    {
      "段": "2.13",
      "事": "雨村发表大仁大恶与正邪两赋之论"
    },
    {
