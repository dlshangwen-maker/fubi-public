  "事件": [
    {
      "段": "3.1",
      "事": "张如圭告知雨村起复旧员之信，冷子兴献计让雨村央求林如海转托贾政"
    },
    {
      "段": "3.2",
      "事": "林如海修荐书托内兄贾政照应雨村，约雨村随黛玉同路进京"
    },
    {
      "段": "3.3",
      "事": "黛玉洒泪拜别父亲，随奶娘及荣府老妇登舟，雨村另船随行"
    },
    {
      "段": "3.4",
      "事": "雨村持宗侄名帖拜见贾政，得其帮助复职，选了金陵应天府"
    },
    {
      "段": "3.5",
      "事": "黛玉登岸乘轿入京，经过敕造宁国府，由西角门进荣国府"
    },
    {
      "段": "3.8",
      "事": "黛玉拜见外祖母，贾母搂住大哭，又引见邢夫人、王夫人、李纨"
    },
    {
      "段": "3.9",
      "事": "三位姑娘来见；黛玉谈及自幼多病和癞头和尚的话"
    },
    {
      "段": "3.11",
      "事": "王熙凤笑语而来，贾母称她凤辣子，熙凤拉着黛玉问长问短"
    },
    {
      "段": "3.15",
      "事": "王夫人问熙凤月钱缎子之事，熙凤说已为黛玉预备了衣料"
    },
    {
      "段": "3.17",
      "事": "邢夫人带黛玉去见贾赦，贾赦托病不见，传话劝慰"
    },
    {
      "段": "3.20",
      "事": "黛玉到荣府正内室，见荣禧堂匾额和对联，又到王夫人房中"
    },
    {
      "段": "3.23",
      "事": "王夫人嘱咐黛玉不要睬她的“混世魔王”儿子宝玉"
    },
    {
      "段": "3.26",
      "事": "黛玉在贾母处用晚饭，随和府中饭后漱口吃茶的规矩"
    },
    {
      "段": "3.28",
      "事": "宝玉回来，黛玉一见觉得眼熟；宝玉换了衣服再来与黛玉见礼"
    },
    {
      "段": "3.36",
      "事": "宝玉说曾见过这个妹妹，并为黛玉取字颦颦"
    },
    {
      "段": "3.38",
      "事": "宝玉问黛玉有无玉，听说没有，便摔玉发狂，贾母以黛玉之玉殉葬之说哄住他"
    },
    {
      "段": "3.39",
      "事": "贾母安排黛玉住碧纱橱，宝玉住碧纱橱外，并把鹦哥给了黛玉"
    },
    {
      "段": "3.42",
      "事": "交代袭人原名蕊珠，是贾母给宝玉的丫头，宝玉为她改名"
    },
    {
      "段": "3.43",
      "事": "当晚黛玉因宝玉摔玉伤心，袭人进来劝慰"
    },
    {
      "段": "3.44",
      "事": "次早王夫人处得金陵来信，说薛蟠打死人命，王子腾意欲唤其进京"
    }
