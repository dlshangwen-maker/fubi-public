 "前几章事件": [
  {
   "段": "1.1",
   "事": "早饭时，华生拾起昨晚来访的客人落下的手杖，杖上刻着赠詹姆斯·莫蒂默的字样和年份1884。"
  },
  {
   "段": "1.2",
   "事": "福尔摩斯背对华生，却知道他在看手杖，要他说说看出了什么。"
  },
  {
   "段": "1.6",
   "事": "华生推断主人是上了年纪、受人敬重的乡村医生，C.C.H.是当地狩猎会。"
  },
  {
   "段": "1.13",
   "事": "福尔摩斯称赞华生能激发别人的才能。"
  },
  {
   "段": "1.14",
   "事": "福尔摩斯用凸透镜仔细察看手杖。"
  },
  {
   "段": "1.17",
   "事": "福尔摩斯说华生的结论大部分错了，只有乡村医生、常走路两点对。"
  },
  {
   "段": "1.21",
   "事": "福尔摩斯推断C.C.H.是查令十字医院，礼物是主人离开医院下乡时所送。"
  },
  {
   "段": "1.29",
   "事": "福尔摩斯推断主人是不到三十岁的年轻人，曾任住院医生，和蔼、没野心、心不在焉，养着一条中等大小的狗。"
  },
  {
   "段": "1.32",
   "事": "华生查《医生名录》，念出莫蒂默的条目。"
  },
  {
   "段": "1.35",
   "事": "福尔摩斯根据牙印断定那是一条卷毛西班牙猎犬。"
  },
  {
   "段": "1.38",
   "事": "福尔摩斯从窗口看见那条狗在门口，主人正按门铃。"
  },
  {
   "段": "1.39",
   "事": "莫蒂默医生进门，欢喜地认出自己的手杖。"
  },
  {
   "段": "1.43",
   "事": "莫蒂默说手杖是结婚时医院朋友送的，打乱了福尔摩斯的部分推断。"
  },
  {
   "段": "1.53",
   "事": "莫蒂默对福尔摩斯的头骨大感兴趣，想摸他的顶骨缝。"
  },
  {
   "段": "1.57",
   "事": "莫蒂默说自己碰上了一个极其严重、极不寻常的难题，称福尔摩斯是欧洲第二的专家。"
  },
  {
   "段": "1.62",
   "事": "福尔摩斯请他别再绕弯子，直说要帮的是什么忙。"
  },
  {
   "段": "2.6",
   "事": "福尔摩斯从露出的部分判断莫蒂默口袋里的手稿是18世纪初的，实为1742年。"
  },
  {
   "段": "2.7",
   "事": "莫蒂默说手稿是约三个月前惨死的查尔斯·巴斯克维尔爵士托他保管的。"
  },
  {
   "段": "2.15",
   "事": "莫蒂默念手稿：大叛乱时雨果·巴斯克维尔抢走自耕农的女儿，追她到荒原深涧，姑娘死去，雨果被一头巨大的黑色猎犬状野兽咬断喉咙。"
  },
  {
   "段": "2.15",
   "事": "手稿说此后猎犬一直纠缠家族，告诫子孙夜里不要穿越荒原。"
  },
  {
   "段": "2.19",
   "事": "福尔摩斯说这故事只对收集童话的人有意思。"
  },
  {
   "段": "2.23",
   "事": "莫蒂默念《德文郡纪事报》：查尔斯爵士5月4日夜在紫杉小径散步时死去，死因调查裁定为自然死亡。"
  },
  {
   "段": "2.23",
   "事": "报道提到通荒原的门以后脚印像踮着脚尖，吉卜赛马贩子墨菲听见喊叫，死者面部严重扭曲。"
  },
  {
   "段": "2.23",
   "事": "报道说继承人是查尔斯爵士的侄子亨利·巴斯克维尔，最后有消息时在美洲。"
  },
  {
   "段": "2.28",
   "事": "莫蒂默说出死因调查时没讲的事。"
  },
  {
   "段": "2.30",
   "事": "莫蒂默说查尔斯爵士近几个月神经紧张，深信家族厄运，常问他是否听见猎犬嚎叫。"
  },
  {
   "段": "2.31",
   "事": "出事前约三周，查尔斯爵士在大门口看见莫蒂默身后有东西，莫蒂默只瞥见像黑色大牛犊的东西，随后获赠手稿保管。"
  },
  {
   "段": "2.32",
   "事": "莫蒂默和斯台普顿都劝查尔斯爵士去伦敦休养。"
  },
  {
   "段": "2.33",
   "事": "出事当夜，巴里摩尔派马夫珀金斯请莫蒂默，莫蒂默一小时内赶到，核对了脚印和尸体。"
  },
  {
   "段": "2.33",
   "事": "莫蒂默说巴里摩尔在死因调查中称尸体周围没有痕迹，但他看见了新鲜清楚的痕迹。"
  },
  {
   "段": "2.38",
   "事": "莫蒂默说那是一条巨大的猎犬的脚印。"
  },
  {
   "段": "3.7",
   "事": "莫蒂默说猎犬脚印离尸体约二十码，没人注意。"
  },
  {
   "段": "3.19",
   "事": "福尔摩斯询问紫杉小径的布局：两排高树篱，中间小路，只有通荒原的门和尽头凉亭两个出口。"
  },
  {
   "段": "3.30",
   "事": "莫蒂默说脚印在小路上，与通荒原的门同一边；小门关着并上了挂锁，约四英尺高。"
  },
  {
   "段": "3.47",
   "事": "莫蒂默从雪茄两回落灰推断查尔斯爵士在门边站了五到十分钟。"
  },
  {
   "段": "3.51",
   "事": "福尔摩斯懊恼自己不在场，现场已被雨水和乡下人踩坏。"
  },
  {
   "段": "3.60",
   "事": "莫蒂默说出事前有三个人在荒原上见过一个发光的庞然大物，与传说中的魔犬一样。"
  },
  {
   "段": "3.68",
   "事": "莫蒂默请福尔摩斯出主意，该如何安置即将到达滑铁卢车站的继承人亨利·巴斯克维尔爵士。"
  },
  {
   "段": "3.72",
   "事": "莫蒂默介绍巴斯克维尔家三兄弟：老大查尔斯、早死的老二（亨利之父）、死在中美洲的老三罗杰。"
  },
  {
   "段": "3.80",
   "事": "福尔摩斯建议莫蒂默去接亨利爵士，暂时什么也别跟他说，并约他次日上午十点带亨利爵士来。"
  },
  {
   "段": "3.88",
   "事": "莫蒂默说查尔斯爵士死后没听说还有人见过那个幽灵。"
  },
  {
   "段": "3.95",
   "事": "华生在俱乐部待了一天，傍晚近九点回到烟雾弥漫的贝克街。"
  },
  {
   "段": "3.105",
   "事": "福尔摩斯推断华生一整天都在俱乐部。"
  },
  {
   "段": "3.111",
   "事": "福尔摩斯说自己对着陆军测绘局地图“神游”了德文郡一整天。"
  },
  {
   "段": "3.116",
   "事": "福尔摩斯在地图上指出庄园、格林彭村、拉夫特庄园、可能是斯台普顿的住处、两座农庄和普林斯敦监狱。"
  },
  {
   "段": "3.128",
   "事": "福尔摩斯推断查尔斯爵士不是踮脚走，而是在拼命逃跑，直到心脏迸裂。"
  },
  {
   "段": "3.132",
   "事": "福尔摩斯指出他吓得背着宅子跑，并提出他当夜在通荒原的门口等人。"
  },
  {
   "段": "4.1",
   "事": "十点，莫蒂默医生领着亨利·巴斯克维尔爵士来到贝克街。"
  },
  {
   "段": "4.6",
   "事": "亨利爵士拿出早上送到诺森伯兰旅馆的信，邮戳是查令十字，前一天晚上寄出。"
  },
  {
   "段": "4.12",
   "事": "信上用剪贴的字写着：如果你珍惜自己的性命或理智，就离荒原远一点；“荒原”是手写的。"
  },
  {
   "段": "4.28",
   "事": "福尔摩斯指出这些字剪自昨天《泰晤士报》一篇谈自由贸易的社论。"
  },
  {
   "段": "4.45",
   "事": "福尔摩斯推断写信人受过教育、想掩饰笔迹，贴字时很匆忙。"
  },
  {
   "段": "4.49",
   "事": "福尔摩斯从笔墨的毛病推断地址是在旅馆里写的。"
  },
  {
   "段": "4.64",
   "事": "亨利爵士说放在房门外擦的一只新买的棕色靴子不见了。"
  },
  {
   "段": "4.72",
   "事": "莫蒂默向亨利爵士重讲了手稿和案情。"
  },
  {
   "段": "4.84",
   "事": "亨利爵士说无论魔鬼还是人都拦不住他回祖辈的家，约福尔摩斯和华生两点去旅馆吃午饭。"
  },
  {
   "段": "4.92",
   "事": "客人一走，福尔摩斯拉着华生上街尾随亨利爵士和莫蒂默。"
  },
  {
   "段": "4.97",
   "事": "一辆马车里的黑胡子男人发现被盯上，喊车夫顺摄政街飞驰而去，福尔摩斯追赶不及。"
  },
  {
   "段": "4.108",
   "事": "福尔摩斯记下了马车车号2704。"
  },
  {
   "段": "4.114",
   "事": "福尔摩斯推断那人的胡子十有八九是假的。"
  },
  {
   "段": "4.115",
   "事": "福尔摩斯到送信公司找经理威尔逊，叫来小伙计卡特赖特。"
  },
  {
   "段": "4.132",
   "事": "福尔摩斯派卡特赖特去查令十字附近二十三家旅馆找剪过的《泰晤士报》，傍晚前电报回复。"
  },
  {
   "段": "5.1",
   "事": "福尔摩斯和华生在画廊看了两小时画，然后去诺森伯兰旅馆。"
  },
  {
   "段": "5.5",
   "事": "福尔摩斯查看旅客登记簿，问明新住客约翰逊和奥尔德莫尔太太的来历。"
  },
  {
   "段": "5.12",
   "事": "福尔摩斯据此推断监视亨利爵士的人没有住进这家旅馆。"
  },
  {
   "段": "5.15",
   "事": "亨利爵士又丢了一只旧黑靴子，大发脾气。"
  },
  {
   "段": "5.36",
   "事": "午饭后亨利爵士说这个周末就去巴斯克维尔庄园。"
  },
  {
   "段": "5.42",
   "事": "福尔摩斯问起黑胡子，莫蒂默说管家巴里摩尔留着一大把黑胡子。"
  },
  {
   "段": "5.47",
   "事": "福尔摩斯发电报查巴里摩尔是否在庄园。"
  },
  {
   "段": "5.53",
   "事": "莫蒂默说遗嘱给巴里摩尔夫妇各五百镑、给自己一千镑，剩下七十四万镑归亨利爵士。"
  },
  {
   "段": "5.65",
   "事": "莫蒂默说亨利爵士若出事，财产会传给远房表亲德斯蒙德家。"
  },
  {
   "段": "5.78",
   "事": "福尔摩斯推荐华生陪亨利爵士去庄园，华生答应。"
  },
  {
   "段": "5.86",
   "事": "约定星期六在帕丁顿车站十点半的火车上碰头。"
  },
  {
   "段": "5.87",
   "事": "亨利爵士在柜子底下找到了丢的那只棕色靴子，侍者说什么也不知道。"
  },
  {
   "段": "5.96",
   "事": "电报回来：巴里摩尔在庄园。"
  },
  {
   "段": "5.98",
   "事": "卡特赖特电报说二十三家旅馆都没找到剪过的《泰晤士报》。"
  },
  {
   "段": "5.102",
   "事": "2704号车夫约翰·克莱顿找上门来。"
  },
  {
   "段": "5.118",
   "事": "克莱顿说那个乘客自称夏洛克·福尔摩斯，福尔摩斯大笑。"
  },
  {
   "段": "5.127",
   "事": "克莱顿讲出乘客的行踪：从特拉法尔加广场上车，跟踪到贝克街和摄政街，最后在滑铁卢车站下车。"
  },
  {
   "段": "5.139",
   "事": "福尔摩斯说第三条线索也断了，对派华生去德文郡感到不踏实。"
  },
  {
   "段": "6.2",
   "事": "福尔摩斯送华生到车站，要他只报告事实，研究亨利爵士周围的人，并带好左轮手枪。"
  },
  {
   "段": "6.12",
   "事": "莫蒂默说这两天没人跟踪，但他和亨利爵士前一天下午分开过。"
  },
  {
   "段": "6.19",
   "事": "福尔摩斯提醒亨利爵士别独自走动，夜里别上荒原。"
  },
  {
   "段": "6.21",
   "事": "火车驶进德文郡，亨利爵士兴奋地看着风景，第一次望见荒原。"
  },
  {
   "段": "6.28",
   "事": "在小站下车，看到站外有军人模样的人，车夫赶马车接他们。"
  },
  {
   "段": "6.31",
   "事": "路上看见一个骑马的士兵持枪监视道路。"
  },
  {
   "段": "6.33",
   "事": "车夫珀金斯说普林斯敦有个囚犯逃出三天，是诺丁山杀人犯塞尔登。"
  },
  {
   "段": "6.40",
   "事": "车夫指出洼地里的巴斯克维尔庄园。"
  },
  {
   "段": "6.41",
   "事": "经过已成废墟的门房和查尔斯爵士盖了一半的新房子。"
  },
  {
   "段": "6.46",
   "事": "亨利爵士说半年内要在庄园装电灯。"
  },
  {
   "段": "6.49",
   "事": "巴里摩尔在门廊迎接，莫蒂默随即回家。"
  },
  {
   "段": "6.58",
   "事": "巴里摩尔说他和妻子愿暂时留下，但打算离开庄园自谋生计。"
  },
  {
   "段": "6.69",
   "事": "亨利爵士和华生在阴沉的餐厅吃晚饭。"
  },
  {
   "段": "6.70",
   "事": "亨利爵士说这地方不让人高兴，两人早早去睡。"
  },
  {
   "段": "6.72",
   "事": "深夜华生听见宅子里有一个女人压抑的抽泣声。"
  },
  {
   "段": "7.3",
   "事": "早饭时华生问起夜里的哭声，亨利爵士说也似乎听见了。"
  },
  {
   "段": "7.7",
   "事": "巴里摩尔说房子里只有洗碗女仆和他妻子，哭声不会是他妻子。"
  },
  {
   "段": "7.8",
   "事": "华生在长廊碰见眼睛红肿的巴里摩尔太太，断定巴里摩尔在撒谎，怀疑他就是摄政街的跟踪者。"
  },
  {
   "段": "7.9",
   "事": "华生到格林彭找邮政局长查问电报。"
  },
  {
   "段": "7.15",
   "事": "送电报的孩子说电报交给了巴里摩尔太太，没见到巴里摩尔本人，无法证明他当时不在伦敦。"
  },
  {
   "段": "7.22",
   "事": "斯台普顿追上华生自我介绍，住在梅里皮特宅。"
  },
  {
   "段": "7.32",
   "事": "斯台普顿说他猜查尔斯爵士那晚在紫杉小径真看见了某种东西，心脏受不了。"
  },
  {
   "段": "7.40",
   "事": "斯台普顿知道华生的身份，打听福尔摩斯的看法，被华生婉拒。"
  },
  {
   "段": "7.58",
   "事": "斯台普顿指给华生看格林彭大泥沼，一匹荒原小马陷进去被吞没。"
  },
  {
   "段": "7.68",
   "事": "荒原上传来一声低沉悠长的哀号，斯台普顿说乡下人认为是巴斯克维尔的猎犬在呼唤猎物，又说可能是麻鳽。"
  },
  {
   "段": "7.83",
   "事": "斯台普顿介绍山坡上的史前石屋遗迹。"
  },
  {
   "段": "7.88",
   "事": "斯台普顿追一只弄蝶跑向泥沼，一个女人从梅里皮特宅方向走来。"
  },
  {
   "段": "7.90",
   "事": "斯台普顿小姐急切地要华生马上回伦敦、永远别再来荒原，并叮嘱别告诉她哥哥。"
  },
  {
   "段": "7.104",
   "事": "华生表明自己是华生医生，斯台普顿小姐发现认错了人。"
  },
  {
   "段": "7.111",
   "事": "在梅里皮特宅，斯台普顿说自己以前在北方办学校，因传染病倒闭。"
  },
  {
   "段": "7.116",
   "事": "斯台普顿说想去拜访亨利爵士；华生谢绝午饭，告辞。"
  },
  {
   "段": "7.119",
   "事": "斯台普顿小姐抄近路追上华生，请他忘掉那些话，说是心血来潮。"
  },
  {
   "段": "7.128",
   "事": "她说自己相信猎犬的故事，希望亨利爵士离开，但不能让哥哥知道，随后离去。"
  }
 ]
}