    {"段": "10.50", "事": "莫蒂默医生顺路载华生回家，说他的小狗走失在荒原上。"},
    {"段": "10.55", "事": "莫蒂默说住在库姆特雷西的劳拉·莱昂斯缩写是L. L.，并讲了她的身世。"},
    {"段": "10.62", "事": "华生决定第二天去库姆特雷西找劳拉·莱昂斯。"},
    {"段": "10.66", "事": "巴里摩尔告诉华生，三天前最后一次给塞尔登放食物，食物已被拿走。"},
    {"段": "10.73", "事": "巴里摩尔说塞尔登告诉他荒原上还有另一个躲藏的人，不是逃犯。"},
    {"段": "10.82", "事": "巴里摩尔说他盼亨利爵士回伦敦，自己也盼着离开庄园。"},
    {"段": "10.86", "事": "巴里摩尔说那人住在山坡上的古代石屋里，有个小伙子给他送东西。"},
    {"段": "10.89", "事": "华生发誓要尽快揭开石屋里那个人的谜。"}
  ]
}
