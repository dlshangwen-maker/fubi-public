    {"段": "13.21", "事": "晚饭时福尔摩斯问起墙上的家族画像，亨利爵士逐一介绍。"},
    {"段": "13.28", "事": "亨利爵士指出画像中的保王党人就是恶人雨果。"},
    {"段": "13.39", "事": "福尔摩斯举烛遮住雨果画像的帽子和卷发，露出斯台普顿的脸。"},
    {"段": "13.42", "事": "福尔摩斯断定斯台普顿是巴斯克维尔家的人，并打着继承家产的主意。"},
    {"段": "13.48", "事": "第二天一早福尔摩斯向普林斯敦报告了塞尔登的死，并联系了卡特赖特。"},
    {"段": "13.56", "事": "福尔摩斯对亨利爵士说他和华生要回伦敦。"},
    {"段": "13.70", "事": "福尔摩斯要亨利爵士去梅里皮特宅赴宴后打发马车回来，沿直路步行回家。"},
    {"段": "13.81", "事": "福尔摩斯在库姆特雷西车站派卡特赖特回伦敦，以他的名义给亨利爵士发电报。"},
    {"段": "13.85", "事": "福尔摩斯收到雷斯垂德的电报，说带空白逮捕令五点四十分到。"},
    {"段": "13.93", "事": "福尔摩斯告诉劳拉·莱昂斯这是谋杀案，冒充斯台普顿妹妹的是他的妻子。"},
    {"段": "13.102", "事": "福尔摩斯拿出范德勒夫妇的照片和证人描述作证据。"},
    {"段": "13.104", "事": "劳拉·莱昂斯说斯台普顿曾以她离婚为条件向她求婚。"},
    {"段": "13.106", "事": "她说出约见信是斯台普顿口述的，他又劝她别去，并让她发誓保密。"},
    {"段": "13.118", "事": "福尔摩斯说她侥幸逃过一劫，告辞离开。"},
    {"段": "13.120", "事": "雷斯垂德乘伦敦快车到达，与两人会合。"},
    {"段": "13.122", "事": "福尔摩斯打算饭后带雷斯垂德去达特穆尔。"}
  ]
}
