  "事件": [
    {"段": "14.2", "事": "三人夜里坐车回到荒原，在庄园林荫道大门附近下车，走向梅里皮特宅。"},
    {"段": "14.11", "事": "福尔摩斯在离梅里皮特宅约两百码的石头后面设伏。"},
    {"段": "14.19", "事": "华生从窗外看见亨利爵士和斯台普顿在餐厅抽雪茄。"},
    {"段": "14.20", "事": "斯台普顿去了果园角落的外屋，里面传出扭打般的响动。"},
