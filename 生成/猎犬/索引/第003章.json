  "事件": [
    {"段": "3.7", "事": "莫蒂默说猎犬脚印离尸体约二十码，没人注意。"},
    {"段": "3.19", "事": "福尔摩斯询问紫杉小径的布局：两排高树篱，中间小路，只有通荒原的门和尽头凉亭两个出口。"},
    {"段": "3.30", "事": "莫蒂默说脚印在小路上，与通荒原的门同一边；小门关着并上了挂锁，约四英尺高。"},
    {"段": "3.47", "事": "莫蒂默从雪茄两回落灰推断查尔斯爵士在门边站了五到十分钟。"},
    {"段": "3.51", "事": "福尔摩斯懊恼自己不在场，现场已被雨水和乡下人踩坏。"},
    {"段": "3.60", "事": "莫蒂默说出事前有三个人在荒原上见过一个发光的庞然大物，与传说中的魔犬一样。"},
    {"段": "3.68", "事": "莫蒂默请福尔摩斯出主意，该如何安置即将到达滑铁卢车站的继承人亨利·巴斯克维尔爵士。"},
    {"段": "3.72", "事": "莫蒂默介绍巴斯克维尔家三兄弟：老大查尔斯、早死的老二（亨利之父）、死在中美洲的老三罗杰。"},
    {"段": "3.80", "事": "福尔摩斯建议莫蒂默去接亨利爵士，暂时什么也别跟他说，并约他次日上午十点带亨利爵士来。"},
    {"段": "3.88", "事": "莫蒂默说查尔斯爵士死后没听说还有人见过那个幽灵。"},
    {"段": "3.95", "事": "华生在俱乐部待了一天，傍晚近九点回到烟雾弥漫的贝克街。"},
    {"段": "3.105", "事": "福尔摩斯推断华生一整天都在俱乐部。"},
    {"段": "3.111", "事": "福尔摩斯说自己对着陆军测绘局地图“神游”了德文郡一整天。"},
    {"段": "3.116", "事": "福尔摩斯在地图上指出庄园、格林彭村、拉夫特庄园、可能是斯台普顿的住处、两座农庄和普林斯敦监狱。"},
    {"段": "3.128", "事": "福尔摩斯推断查尔斯爵士不是踮脚走，而是在拼命逃跑，直到心脏迸裂。"},
    {"段": "3.132", "事": "福尔摩斯指出他吓得背着宅子跑，并提出他当夜在通荒原的门口等人。"}
