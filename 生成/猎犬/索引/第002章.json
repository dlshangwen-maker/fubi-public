    {"段": "2.6", "事": "福尔摩斯从露出的部分判断莫蒂默口袋里的手稿是18世纪初的，实为1742年。"},
    {"段": "2.7", "事": "莫蒂默说手稿是约三个月前惨死的查尔斯·巴斯克维尔爵士托他保管的。"},
    {"段": "2.15", "事": "莫蒂默念手稿：大叛乱时雨果·巴斯克维尔抢走自耕农的女儿，追她到荒原深涧，姑娘死去，雨果被一头巨大的黑色猎犬状野兽咬断喉咙。"},
    {"段": "2.15", "事": "手稿说此后猎犬一直纠缠家族，告诫子孙夜里不要穿越荒原。"},
    {"段": "2.19", "事": "福尔摩斯说这故事只对收集童话的人有意思。"},
    {"段": "2.23", "事": "莫蒂默念《德文郡纪事报》：查尔斯爵士5月4日夜在紫杉小径散步时死去，死因调查裁定为自然死亡。"},
    {"段": "2.23", "事": "报道提到通荒原的门以后脚印像踮着脚尖，吉卜赛马贩子墨菲听见喊叫，死者面部严重扭曲。"},
    {"段": "2.23", "事": "报道说继承人是查尔斯爵士的侄子亨利·巴斯克维尔，最后有消息时在美洲。"},
    {"段": "2.28", "事": "莫蒂默说出死因调查时没讲的事。"},
    {"段": "2.30", "事": "莫蒂默说查尔斯爵士近几个月神经紧张，深信家族厄运，常问他是否听见猎犬嚎叫。"},
    {"段": "2.31", "事": "出事前约三周，查尔斯爵士在大门口看见莫蒂默身后有东西，莫蒂默只瞥见像黑色大牛犊的东西，随后获赠手稿保管。"},
    {"段": "2.32", "事": "莫蒂默和斯台普顿都劝查尔斯爵士去伦敦休养。"},
    {"段": "2.33", "事": "出事当夜，巴里摩尔派马夫珀金斯请莫蒂默，莫蒂默一小时内赶到，核对了脚印和尸体。"},
    {"段": "2.33", "事": "莫蒂默说巴里摩尔在死因调查中称尸体周围没有痕迹，但他看见了新鲜清楚的痕迹。"},
    {"段": "2.38", "事": "莫蒂默说那是一条巨大的猎犬的脚印。"}
  ]
}
