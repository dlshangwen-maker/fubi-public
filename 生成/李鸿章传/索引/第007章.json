  "事件": [
    {"段": "7.3", "事": "同治十一年日本问朝鲜事，中国答以不与闻；光绪元年日朝订约，承认朝鲜为自主之国。"},
    {"段": "7.3", "事": "光绪五年李鸿章密劝朝鲜与各国立约；光绪六年、八年何如璋、张佩纶主张主持朝鲜外交，李鸿章不从。"},
    {"段": "7.3", "事": "光绪十一年李鸿章与伊藤博文在天津订约，约定派兵须互相知照。"},
    {"段": "7.4", "事": "光绪二十年三月朝鲜东学党之乱，袁世凯请兵；五月初一李鸿章派舰、派叶志超赴牙山，并照会日本。"},
    {"段": "7.4", "事": "日本随即派兵，五月十五日到仁川者已五千；乱党解散后两国就撤兵与干预朝鲜内政僵持。"},
    {"段": "7.6", "事": "李鸿章与总理衙门寄望俄、英调停，迁延误时，五月下旬日兵在韩已万余。"},
    {"段": "7.7", "事": "六月李鸿章派卫汝贵、马玉崑等军入朝；二十五日日舰袭击，方伯谦驾济远逃回旅顺，高升被击沉。"},
    {"段": "7.7", "事": "六月二十九日牙山失守，叶志超退回平壤并捏报胜仗得赏。"},
    {"段": "7.8", "事": "八月十六日大东沟海战，致远邓世昌、经远林永升殉难，方伯谦撞沉扬威后逃，北洋失五舰而日舰无一沉没。"},
    {"段": "7.8", "事": "李鸿章电令将方伯谦军前正法。"},
    {"段": "7.9", "事": "聂士成先据平壤、南袭韩城之策，李鸿章不能用。"},
    {"段": "7.11", "事": "八月十五、十六日日军攻平壤，左宝贵战死，叶志超悬白旗，全军宵遁，平壤陷落。"},
    {"段": "7.14", "事": "平壤败后，依克唐阿、宋庆、吴大澂、刘坤一等先后受命统兵，号令不一。"},
    {"段": "7.19", "事": "九连城、金州、大连湾、旅顺口、威海卫、刘公岛等相继失守，丁汝昌以残舰降日，北洋海军覆没。"},
    {"段": "7.21", "事": "作者列李鸿章在此役中的十二条过错。"},
    {"段": "7.22", "事": "作者为海军与淮军部分辩护，认为全国军旅皆腐败，不能只归罪于李鸿章。"},
    {"段": "7.24", "事": "西报称日本实与李鸿章一人战；刘公岛降舰时有人求日军放还广丙，称此事与广东无涉。"},
    {"段": "7.25", "事": "李鸿章兵事声誉自此终结，外交困难开始。"}
  ]
