  "事件": [
    {"段": "4.4", "事": "咸丰十年，英法美等国改变方针，请为北京政府出兵助剿太平天国；俄公使伊格那面谒恭亲王表示愿派舰队助剿。"},
    {"段": "4.6", "事": "朝廷依曾国藩等的意见谢绝外国出兵，命曾国藩聘请外国军官训练新兵。"},
    {"段": "4.7", "事": "杨坊向吴煦推荐华尔，华尔募中外兵勇防卫苏沪，所部号称常胜军。"},
    {"段": "4.9", "事": "李秀成、李世贤分路攻掠江浙，杭州等地失陷，浙江巡抚王有龄死。"},
    {"段": "4.10", "事": "江苏绅士钱鼎铭到安庆向曾国藩求援。"},
    {"段": "4.11", "事": "曾国藩荐李鸿章为江苏统帅，李鸿章回庐州招募淮勇组建淮军。"},
    {"段": "4.12", "事": "同治元年三月，淮军乘上海官绅所雇轮船抵沪，李鸿章署理江苏巡抚。"},
    {"段": "4.14", "事": "淮军在南汇、川沙、徐家汇等地获胜，松江之围解除。"},
    {"段": "4.16", "事": "同治元年五月，曾国荃进屯金陵城外雨花台。"},
    {"段": "4.19", "事": "华尔攻慈溪中弹身亡，白齐文代领常胜军。"},
    {"段": "4.20", "事": "李秀成、李世贤率二十余万人围攻雨花台曾国荃大营，十月撤兵。"},
    {"段": "4.24", "事": "白齐文殴打杨坊、掠银四万两，李鸿章与英领事交涉将其黜退，改由戈登统领常胜军。"},
    {"段": "4.26", "事": "同治二年二三月，淮军与常胜军解常熟之围，攻克太仓、昆山。"},
    {"段": "4.28", "事": "淮军在北漍、南漍、麦市桥大破李秀成沿运河的连营。"},
    {"段": "4.32", "事": "李秀成夜出苏州，郜云官等刺杀谭绍洸开城投降。"},
    {"段": "4.36", "事": "李鸿章与程学启设宴诱杀八名降将，苏州平定，戈登因此大怒欲杀李鸿章。"},
    {"段": "4.41", "事": "同治三年二月，程学启攻嘉兴中弹，嘉兴攻克；三月程学启去世，左宗棠军入杭州。"},
    {"段": "4.44", "事": "同治三年四月六日，淮军攻克常州，擒陈坤书，江苏除金陵城外全部平定。"},
    {"段": "4.46", "事": "洪秀全服毒死，其子洪福被拥立；李鸿章托词不赴金陵会剿。"},
    {"段": "4.48", "事": "六月十六日曾军以地道炸塌金陵城墙攻入城中，李秀成赠马让幼主出逃，巷战后被擒。"},
    {"段": "4.50", "事": "朝廷论功行赏，曾国藩封侯，曾国荃、李鸿章封伯。"}
