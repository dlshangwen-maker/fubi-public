  "事件": [
    {"段": "10.2", "事": "作者说明李鸿章四十年仅有乙未至丙申、戊戌至庚子两段闲散时期，其间治河、治粤。"},
    {"段": "10.3", "事": "戊戌八月后政府派李鸿章治黄河，其奏议录比利时工程师卢法尔的勘河报告。"},
    {"段": "10.5", "事": "卢法尔报告雒口至盐窝的河身、民埝、大堤、险工状况，指出堤防无保护、多毁损。"},
    {"段": "10.10", "事": "报告叙述黄河尾闾三次改道（铁门关、韩家垣、丝网口）及新挑引河情形。"},
    {"段": "10.16", "事": "报告提出治河须察病原于上游，先测量全河、绘图、查验水性沙数，各省黄河统归一官节制。"},
    {"段": "10.19", "事": "报告建议沿河设电线、定守河章程、上游山地植树。"},
    {"段": "10.21", "事": "报告列出救急办法：培修堤岸、固筑险工、疏通尾闾，并讨论尾闾选址与减水坝。"},
    {"段": "10.24", "事": "李鸿章接李瀚章、谭钟鳞督粤，复就地正法之例严厉治盗，杀戮无算。"},
    {"段": "10.24", "事": "李鸿章以赌博承饷充缉捕经费，作者严厉批评。"},
    {"段": "10.25", "事": "李鸿章从黄遵宪之议拟在省城行警察法，未竟而去。"},
    {"段": "10.26", "事": "李鸿章对袒庇教民的牧师严明权限，此后无人再敢借教为奸。"},
    {"段": "10.27", "事": "李鸿章奉朝旨镇压康党，捕海外义民家属三人。"}
