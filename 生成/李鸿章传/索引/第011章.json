"事件": [
{"段": "11.2", "事": "李鸿章到两广任职不满一年，义和团兴起。"},
{"段": "11.3", "事": "六月以后联军逼近京师，李鸿章再受命为议和全权大臣。"},
{"段": "11.4", "事": "有人为李鸿章划策上、中、下三条，他迟迟北行，在上海逗留数月不发。"},
{"段": "11.5", "事": "两宫出逃后和议开始，光绪二十七年七月定和约十二款。"},
{"段": "11.7", "事": "和约规定惩办载漪、载勋、毓贤等首祸诸臣，为被害的袁昶、许景澄等昭雪。"},
{"段": "11.11", "事": "和约规定赔款海关银四百五十兆两，分三十九年还清。"},
{"段": "11.17", "事": "和约规定总理各国事务衙门改为外务部。"},
{"段": "11.19", "事": "俄国借义和团之事占据吉林、黑龙江直至营口，坚持满洲事件由中俄另议。"},
{"段": "11.19", "事": "联军和约定后，中俄满洲条约开议，初议之约录于后。"},
{"段": "11.32", "事": "草约公布后南方疆吏士民激烈抗争，英、美、日也将干涉，俄使被迫让步修改前约。"},
{"段": "11.45", "事": "李鸿章肝疾加剧，又遭俄使恫喝催促，闻徐寿朋之死而呕血。"},
{"段": "11.45", "事": "光绪二十七年九月廿七日，李鸿章卒于京师贤良寺，满洲条约未定，交庆亲王、王文韶续办。"},
{"段": "11.45", "事": "李鸿章临终恨毓贤误国，叹两宫不肯回銮，享年七十八岁。"},
{"段": "11.46", "事": "朝廷下上谕赐恤，予谥文忠，追赠太傅，晋封一等侯爵，入祀贤良祠。"},
{"段": "11.47", "事": "朝廷又赏银治丧，子李经述袭侯爵，各地建专祠。"},
{"段": "11.47", "事": "作者闻讯作挽联一副。"}
]
