   "事迹": [
    {
     "从": "0.1",
     "写": "作为本书传主被介绍；著者说明书中多为他辩解之言。"
    },
    {
     "从": "1.1",
     "写": "在德国向比斯麦请教如何在受掣肘的朝廷中行其志，比斯麦答后默然；本章其余为著者对他的总评：敬其才、惜其识、悲其遇。"
    },
    {
     "从": "2.2",
     "写": "本章无具体行事，著者论其所处地位：身在专制完满、满人掌权的时代，实权在军机大臣，不应独担四十年失政之责。"
    },
    {
     "从": "3.2",
     "写": "早年中进士入翰林，太平军起后在安徽参赞军事、献策克复含山巢县；后入曾国藩幕，随曾军数年，屡荐未得官。"
    },
    {
     "从": "4.2",
     "写": "组建淮军赴上海，统领淮军与常胜军转战两年，收复苏州、常州等地平定江苏；苏州杀降引戈登大怒；金陵将克时辞不会剿，事后不嫉曾国荃之功。"
    },
    {
     "从": "5.1",
     "写": "定下逼捻不流、先防运河再扼胶莱的方略，顶住朝廷责难坚持不变，先后平定东捻、西捻，同治七年八月入京觐见。"
    },
    {
     "从": "6.2",
     "写": "购船械、筑炮台、办铁路招商局电报局矿务等洋务；同治十一年、光绪元年上奏力主保留造船、筹画海防，言中国遇三千年来一大变局。作者评其知有洋务而不知有国务，为时势所造之英雄。"
    },
    {
     "从": "7.2",
     "写": "密劝朝鲜与各国立约，与伊藤博文订天津条约，听袁世凯之言派兵入朝，迁延待俄英调停；部署平壤守局，下令将方伯谦正法。作者列其十二咎，又认为战败不能全归罪于他一人。"
    }
