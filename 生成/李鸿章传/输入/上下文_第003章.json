    {
     "从": "0.3",
     "写": "四十年来中国大事几乎都与他有关"
    },
    {
     "从": "0.6",
     "写": "在中国备受指责（负谤）；与著者在政治上是对手，私交不深；已去世（“合肥有知，必当微笑于地下”）"
    },
    {
     "从": "1.1",
     "写": "本书传主，毁誉皆达极点的“非常人”"
    },
    {
     "从": "1.2",
     "写": "曾出访欧洲，在德国拜见比斯麦；在朝中受满廷意见掣肘"
    },
    {
     "从": "1.3",
     "写": "被五洲万国视为中国独一无二的代表人，中国近四十年第一流紧要人物"
    },
    {
     "从": "1.5",
     "写": "俗论以平发平捻为其功，以数次和议为其罪；乙未、庚子年间处于议和的位置"
    },
    {
     "从": "1.6",
     "写": "已去世；外国论者称他为中国第一人"
    },
    {
     "从": "1.7",
     "写": "著者认为他是时势所造之英雄，非造时势之英雄"
    },
    {
     "从": "1.8",
     "写": "著者评其不学无术：不识国民原理、不通世界大势，只摭拾泰西皮毛；晚年着着失败"
    },
    {
     "从": "2.2",
     "写": "本书传主，著者要考察其所居之国与所生之时代"
    },
    {
     "从": "2.5",
     "写": "被论者称为近世中国之权臣；著者说若是权臣，比古代可谓纯臣，比近代各国可谓庸臣"
    },
    {
     "从": "2.7",
     "写": "受儒家名教约束、不敢跋扈的人物之一"
    },
    {
     "从": "2.8",
     "写": "汉人大臣，自信力不及曾国藩"
    },
    {
     "从": "2.9",
     "写": "历任大学士、北洋大臣、总理衙门大臣、商务大臣、江苏巡抚，以及湖广、两江、两广、直隶总督"
    },
    {
     "从": "2.16",
     "写": "著者认为他是无学识之人，即使有实权，成就也不会远过今日"
    },
    {
     "从": "3.2",
     "写": "字渐甫，号少荃，安徽庐州府合肥县人；父李进文，母沈氏，四子中排行第二；生于道光三年正月五日（1823）；幼治帖括，二十五岁（道光二十七年）成进士、入翰林"
    },
    {
     "从": "3.5",
     "写": "与曾国藩、左宗棠并称因时而起的一世之雄"
    },
    {
     "从": "3.6",
     "写": "以优贡客居京师时，以文学受知于曾国藩并师事之；咸丰初在安徽原籍佐巡抚福济及吕贤基军事；献策先取含山、巢县，克之，咸丰四年十二月始有知兵之名"
    },
    {
     "从": "3.9",
     "写": "被称为与曾国藩合力图苏皖江浙的“左、李诸贤”之一"
    },
    {
     "从": "3.10",
     "写": "在福济幕时被荐道员遭郑魁士阻挠，受谣言诽谤；后授福建延邵建遗缺道，有名无实；咸丰八年入曾国藩幕；九年随曾国荃赴景德镇参赞；十年曾国藩荐其为江北司道、两淮运使均未成；时年三十八，怀才郁抑"
    }
