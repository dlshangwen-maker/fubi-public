  {
   "段": "0.4",
   "事": "著者说明书中平吴之役多载湘军事迹，是因湘淮两军关系繁杂。"
  },
  {
   "段": "0.5",
   "事": "著者说明书中全文收录《中东和约》《中俄密约》《义和团和约》。"
  },
  {
   "段": "0.6",
   "事": "著者声明与李鸿章政治上为公敌，书中多为其解免之言是出于公平之心，并引格林威尔之语自勉。"
  },
  {
   "段": "0.7",
   "事": "序例署于光绪二十七年十一月既望。"
  },
  {
   "段": "1.1",
   "事": "著者提出毁誉皆达极点者为“非常人”，不可以庸人眼光评判。"
  },
  {
   "段": "1.2",
   "事": "著者自称敬李鸿章之才、惜其识、悲其遇。"
  },
  {
   "段": "1.2",
   "事": "李鸿章访欧至德国，向前宰相比斯麦请教在朝中受掣肘时如何行其志。"
  },
  {
   "段": "1.2",
   "事": "比斯麦答以首在得君，又说与妇人孺子共事则无可如何，李鸿章默然。"
  },
  {
   "段": "1.3",
   "事": "著者指出世界视李鸿章为中国独一无二的代表，本书亦可名为《同光以来大事记》。"
  },
  {
   "段": "1.4",
   "事": "著者主张须观察中国数千年政权变迁与民族消长，才能论定李鸿章的位置。"
  },
  {
   "段": "1.5",
   "事": "著者驳斥俗论以平发平捻为李鸿章之功、以和议为其罪，并引比斯麦关于同种相残的话。"
  },
  {
   "段": "1.6",
   "事": "李鸿章已死，外国论者称其为中国第一人，认为其死将使中国全局大变动。"
  },
  {
   "段": "1.7",
   "事": "著者判断李鸿章是时势所造之英雄，而非造时势之英雄。"
  },
  {
   "段": "1.8",
   "事": "著者借史家评霍光的“不学无术”评李鸿章，认为其晚年失败皆由于此，但也归因于其时其地。"
  },
  {
   "段": "2.3",
   "事": "著者指出李鸿章所居为君权专制进化达于极点之国。"
  },
  {
   "段": "2.4",
   "事": "著者指出李鸿章所居为满洲人入主、汉人权利渐复之时代。"
  },
  {
   "段": "2.5",
   "事": "著者辨析“李鸿章为权臣”之说：较古代权臣为纯臣，较近代各国大臣为庸臣。"
  },
  {
   "段": "2.6",
   "事": "著者将中国历代权臣分为四种并列举代表人物。"
  },
  {
   "段": "2.7",
   "事": "著者认为权臣愈近代愈少，原因在儒家教义浸淫与历代雄主削权。"
  },
  {
   "段": "2.8",
   "事": "著者指出本朝二百年来唯满员有权臣，历次军兴皆用旗营。"
  },
  {
   "段": "2.8",
   "事": "赛尚阿、琦善率八旗征讨洪杨失机，朝廷始委任汉人；金田一役为满汉权力消长之关头。"
  },
  {
   "段": "2.8",
   "事": "曾国藩、胡林翼平江南时仍须推官文为首，曾在金陵克捷后战战兢兢。"
  },
  {
   "段": "2.9",
   "事": "著者列李鸿章历任官职，指出本朝实权在军机大臣。"
  },
  {
   "段": "2.10",
   "事": "著者列出同治以来五个时代有实力的军机大臣。"
  },
  {
   "段": "2.15",
   "事": "著者据表说明同治以后汉人在封疆与枢府的实力骤增，戊戌八月后形势又变。"
  },
  {
   "段": "2.16",
   "事": "著者认为李鸿章的共事者皆非同心同见识之人，但也认为李鸿章本无学识，不为其作辩护。"
  },
  {
   "段": "2.16",
   "事": "著者主张不可把中国失政尽归李鸿章一人，以免枢臣与国民推卸责任。"
  }
