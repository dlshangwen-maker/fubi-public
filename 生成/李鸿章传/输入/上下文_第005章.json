 "前几章事件": [
  {
   "段": "0.1",
   "事": "著者说明本书仿西人传记体，记述李鸿章一生行事并加论断。"
  },
  {
   "段": "0.2",
   "事": "著者说明中国旧体记事不下论赞，本书效仿太史公夹叙夹议之例。"
  },
  {
   "段": "0.3",
   "事": "著者说明须以作近世史之笔力为李鸿章作传，并承认时间仓促、无书可考，难免谬误。"
  },
  {
   "段": "0.4",
   "事": "著者说明书中平吴之役多载湘军事迹，是因湘淮两军关系繁杂。"
  },
  {
   "段": "0.5",
   "事": "著者说明书中全文收录《中东和约》《中俄密约》《义和团和约》。"
  },
  {
   "段": "0.6",
   "事": "著者声明与李鸿章政治上为公敌，书中多为其解免之言是出于公平之心，并引格林威尔之语自勉。"
  },
  {
   "段": "0.7",
   "事": "序例署于光绪二十七年十一月既望。"
  },
  {
   "段": "1.1",
   "事": "著者提出毁誉皆达极点者为“非常人”，不可以庸人眼光评判。"
  },
  {
   "段": "1.2",
   "事": "著者自称敬李鸿章之才、惜其识、悲其遇。"
  },
  {
   "段": "1.2",
   "事": "李鸿章访欧至德国，向前宰相比斯麦请教在朝中受掣肘时如何行其志。"
  },
  {
   "段": "1.2",
   "事": "比斯麦答以首在得君，又说与妇人孺子共事则无可如何，李鸿章默然。"
  },
  {
   "段": "1.3",
   "事": "著者指出世界视李鸿章为中国独一无二的代表，本书亦可名为《同光以来大事记》。"
  },
  {
   "段": "1.4",
   "事": "著者主张须观察中国数千年政权变迁与民族消长，才能论定李鸿章的位置。"
  },
  {
   "段": "1.5",
   "事": "著者驳斥俗论以平发平捻为李鸿章之功、以和议为其罪，并引比斯麦关于同种相残的话。"
  },
  {
   "段": "1.6",
   "事": "李鸿章已死，外国论者称其为中国第一人，认为其死将使中国全局大变动。"
  },
  {
   "段": "1.7",
   "事": "著者判断李鸿章是时势所造之英雄，而非造时势之英雄。"
  },
  {
   "段": "1.8",
   "事": "著者借史家评霍光的“不学无术”评李鸿章，认为其晚年失败皆由于此，但也归因于其时其地。"
  },
  {
   "段": "2.3",
   "事": "著者指出李鸿章所居为君权专制进化达于极点之国。"
  },
  {
   "段": "2.4",
   "事": "著者指出李鸿章所居为满洲人入主、汉人权利渐复之时代。"
  },
  {
   "段": "2.5",
   "事": "著者辨析“李鸿章为权臣”之说：较古代权臣为纯臣，较近代各国大臣为庸臣。"
  },
  {
   "段": "2.6",
   "事": "著者将中国历代权臣分为四种并列举代表人物。"
  },
  {
   "段": "2.7",
   "事": "著者认为权臣愈近代愈少，原因在儒家教义浸淫与历代雄主削权。"
  },
  {
   "段": "2.8",
   "事": "著者指出本朝二百年来唯满员有权臣，历次军兴皆用旗营。"
  },
  {
   "段": "2.8",
   "事": "赛尚阿、琦善率八旗征讨洪杨失机，朝廷始委任汉人；金田一役为满汉权力消长之关头。"
  },
  {
   "段": "2.8",
   "事": "曾国藩、胡林翼平江南时仍须推官文为首，曾在金陵克捷后战战兢兢。"
  },
  {
   "段": "2.9",
   "事": "著者列李鸿章历任官职，指出本朝实权在军机大臣。"
  },
  {
   "段": "2.10",
   "事": "著者列出同治以来五个时代有实力的军机大臣。"
  },
  {
   "段": "2.15",
   "事": "著者据表说明同治以后汉人在封疆与枢府的实力骤增，戊戌八月后形势又变。"
  },
  {
   "段": "2.16",
   "事": "著者认为李鸿章的共事者皆非同心同见识之人，但也认为李鸿章本无学识，不为其作辩护。"
  },
  {
   "段": "2.16",
   "事": "著者主张不可把中国失政尽归李鸿章一人，以免枢臣与国民推卸责任。"
  },
  {
   "段": "3.2",
   "事": "李鸿章生于道光三年，二十五岁成进士、入翰林。"
  },
  {
   "段": "3.3",
   "事": "李鸿章出生时，西力东渐，中国与俄、英先后发生交涉与战事。"
  },
  {
   "段": "3.4",
   "事": "乾隆以后国内相继发生红苗、白莲教、蔡牵、天理教、张格尔等乱事。"
  },
  {
   "段": "3.5",
   "事": "著者论中国历史为流血之历史，明遗民秘密党会不绝，洪秀全与曾国藩、李鸿章等因时而起。"
  },
  {
   "段": "3.6",
   "事": "李鸿章以优贡客京师，受知于曾国藩并师事之。"
  },
  {
   "段": "3.6",
   "事": "金田之乱起，洪秀全两年余蹂躏全国之半。"
  },
  {
   "段": "3.6",
   "事": "李鸿章在安徽佐福济，献策先取含山、巢县，克之，咸丰四年十二月始有知兵之名。"
  },
  {
   "段": "3.7",
   "事": "曾国藩以丁忧侍郎奉旨帮办团练，湘军起。"
  },
  {
   "段": "3.8",
   "事": "洪秀全据金陵后内部相残；金陵大营于咸丰六年、十年两次溃败，江浙沦陷。"
  },
  {
   "段": "3.8",
   "事": "英法联军入北京烧圆明园。"
  },
  {
   "段": "3.9",
   "事": "咸丰十年四月，曾国藩署两江总督并授钦差大臣，兵饷之权归一。"
  },
  {
   "段": "3.10",
   "事": "福济疏荐李鸿章为道员，遭郑魁士阻挠；李受谤几不能立足乡里。"
  },
  {
   "段": "3.10",
   "事": "咸丰八年李鸿章谒曾国藩于建昌，留其幕中。"
  },
  {
   "段": "3.10",
   "事": "咸丰九年五月李鸿章随曾国荃赴景德镇参赞军事。"
  },
  {
   "段": "3.10",
   "事": "咸丰十年曾国藩荐李鸿章为江北司道、两淮运使，均未成；李时年三十八。"
  },
  {
   "段": "4.4",
   "事": "咸丰十年，英法美等国改变方针，请为北京政府出兵助剿太平天国；俄公使伊格那面谒恭亲王表示愿派舰队助剿。"
  },
  {
   "段": "4.6",
   "事": "朝廷依曾国藩等的意见谢绝外国出兵，命曾国藩聘请外国军官训练新兵。"
  },
  {
   "段": "4.7",
   "事": "杨坊向吴煦推荐华尔，华尔募中外兵勇防卫苏沪，所部号称常胜军。"
  },
  {
   "段": "4.9",
   "事": "李秀成、李世贤分路攻掠江浙，杭州等地失陷，浙江巡抚王有龄死。"
  },
  {
   "段": "4.10",
   "事": "江苏绅士钱鼎铭到安庆向曾国藩求援。"
  },
  {
   "段": "4.11",
   "事": "曾国藩荐李鸿章为江苏统帅，李鸿章回庐州招募淮勇组建淮军。"
  },
  {
   "段": "4.12",
   "事": "同治元年三月，淮军乘上海官绅所雇轮船抵沪，李鸿章署理江苏巡抚。"
  },
  {
   "段": "4.14",
   "事": "淮军在南汇、川沙、徐家汇等地获胜，松江之围解除。"
  },
  {
   "段": "4.16",
   "事": "同治元年五月，曾国荃进屯金陵城外雨花台。"
  },
  {
   "段": "4.19",
   "事": "华尔攻慈溪中弹身亡，白齐文代领常胜军。"
  },
  {
   "段": "4.20",
   "事": "李秀成、李世贤率二十余万人围攻雨花台曾国荃大营，十月撤兵。"
  },
  {
   "段": "4.24",
   "事": "白齐文殴打杨坊、掠银四万两，李鸿章与英领事交涉将其黜退，改由戈登统领常胜军。"
  },
  {
   "段": "4.26",
   "事": "同治二年二三月，淮军与常胜军解常熟之围，攻克太仓、昆山。"
  },
  {
   "段": "4.28",
   "事": "淮军在北漍、南漍、麦市桥大破李秀成沿运河的连营。"
  },
  {
   "段": "4.32",
   "事": "李秀成夜出苏州，郜云官等刺杀谭绍洸开城投降。"
  },
  {
   "段": "4.36",
   "事": "李鸿章与程学启设宴诱杀八名降将，苏州平定，戈登因此大怒欲杀李鸿章。"
  },
  {
   "段": "4.41",
   "事": "同治三年二月，程学启攻嘉兴中弹，嘉兴攻克；三月程学启去世，左宗棠军入杭州。"
  },
  {
   "段": "4.44",
   "事": "同治三年四月六日，淮军攻克常州，擒陈坤书，江苏除金陵城外全部平定。"
  },
  {
   "段": "4.46",
   "事": "洪秀全服毒死，其子洪福被拥立；李鸿章托词不赴金陵会剿。"
  },
  {
   "段": "4.48",
   "事": "六月十六日曾军以地道炸塌金陵城墙攻入城中，李秀成赠马让幼主出逃，巷战后被擒。"
  },
  {
   "段": "4.50",
   "事": "朝廷论功行赏，曾国藩封侯，曾国荃、李鸿章封伯。"
  }
 ]
}