 "前几章事件": [
  {
   "段": "0.1",
   "事": "著者说明本书仿西人传记体，记述李鸿章一生行事并加论断。"
  },
  {
   "段": "0.2",
   "事": "著者说明中国旧体记事不下论赞，本书效仿太史公夹叙夹议之例。"
  },
  {
   "段": "0.3",
   "事": "著者说明须以作近世史之笔力为李鸿章作传，并承认时间仓促、无书可考，难免谬误。"
  },
  {
   "段": "0.4",
   "事": "著者说明书中平吴之役多载湘军事迹，是因湘淮两军关系繁杂。"
  },
  {
   "段": "0.5",
   "事": "著者说明书中全文收录《中东和约》《中俄密约》《义和团和约》。"
  },
  {
   "段": "0.6",
   "事": "著者声明与李鸿章政治上为公敌，书中多为其解免之言是出于公平之心，并引格林威尔之语自勉。"
  },
  {
   "段": "0.7",
   "事": "序例署于光绪二十七年十一月既望。"
  },
  {
   "段": "1.1",
   "事": "著者提出毁誉皆达极点者为“非常人”，不可以庸人眼光评判。"
  },
  {
   "段": "1.2",
   "事": "著者自称敬李鸿章之才、惜其识、悲其遇。"
  },
  {
   "段": "1.2",
   "事": "李鸿章访欧至德国，向前宰相比斯麦请教在朝中受掣肘时如何行其志。"
  },
  {
   "段": "1.2",
   "事": "比斯麦答以首在得君，又说与妇人孺子共事则无可如何，李鸿章默然。"
  },
  {
   "段": "1.3",
   "事": "著者指出世界视李鸿章为中国独一无二的代表，本书亦可名为《同光以来大事记》。"
  },
  {
   "段": "1.4",
   "事": "著者主张须观察中国数千年政权变迁与民族消长，才能论定李鸿章的位置。"
  },
  {
   "段": "1.5",
   "事": "著者驳斥俗论以平发平捻为李鸿章之功、以和议为其罪，并引比斯麦关于同种相残的话。"
  },
  {
   "段": "1.6",
   "事": "李鸿章已死，外国论者称其为中国第一人，认为其死将使中国全局大变动。"
  },
  {
   "段": "1.7",
   "事": "著者判断李鸿章是时势所造之英雄，而非造时势之英雄。"
  },
  {
   "段": "1.8",
   "事": "著者借史家评霍光的“不学无术”评李鸿章，认为其晚年失败皆由于此，但也归因于其时其地。"
  },
  {
   "段": "2.3",
   "事": "著者指出李鸿章所居为君权专制进化达于极点之国。"
  },
  {
   "段": "2.4",
   "事": "著者指出李鸿章所居为满洲人入主、汉人权利渐复之时代。"
  },
  {
   "段": "2.5",
   "事": "著者辨析“李鸿章为权臣”之说：较古代权臣为纯臣，较近代各国大臣为庸臣。"
  },
  {
   "段": "2.6",
   "事": "著者将中国历代权臣分为四种并列举代表人物。"
  },
  {
   "段": "2.7",
   "事": "著者认为权臣愈近代愈少，原因在儒家教义浸淫与历代雄主削权。"
  },
  {
   "段": "2.8",
   "事": "著者指出本朝二百年来唯满员有权臣，历次军兴皆用旗营。"
  },
  {
   "段": "2.8",
   "事": "赛尚阿、琦善率八旗征讨洪杨失机，朝廷始委任汉人；金田一役为满汉权力消长之关头。"
  },
  {
   "段": "2.8",
   "事": "曾国藩、胡林翼平江南时仍须推官文为首，曾在金陵克捷后战战兢兢。"
  },
  {
   "段": "2.9",
   "事": "著者列李鸿章历任官职，指出本朝实权在军机大臣。"
  },
  {
   "段": "2.10",
   "事": "著者列出同治以来五个时代有实力的军机大臣。"
  },
  {
   "段": "2.15",
   "事": "著者据表说明同治以后汉人在封疆与枢府的实力骤增，戊戌八月后形势又变。"
  },
  {
   "段": "2.16",
   "事": "著者认为李鸿章的共事者皆非同心同见识之人，但也认为李鸿章本无学识，不为其作辩护。"
  },
  {
   "段": "2.16",
   "事": "著者主张不可把中国失政尽归李鸿章一人，以免枢臣与国民推卸责任。"
  },
  {
   "段": "3.2",
   "事": "李鸿章生于道光三年，二十五岁成进士、入翰林。"
  },
  {
   "段": "3.3",
   "事": "李鸿章出生时，西力东渐，中国与俄、英先后发生交涉与战事。"
  },
  {
   "段": "3.4",
   "事": "乾隆以后国内相继发生红苗、白莲教、蔡牵、天理教、张格尔等乱事。"
  },
  {
   "段": "3.5",
   "事": "著者论中国历史为流血之历史，明遗民秘密党会不绝，洪秀全与曾国藩、李鸿章等因时而起。"
  },
  {
   "段": "3.6",
   "事": "李鸿章以优贡客京师，受知于曾国藩并师事之。"
  },
  {
   "段": "3.6",
   "事": "金田之乱起，洪秀全两年余蹂躏全国之半。"
  },
  {
   "段": "3.6",
   "事": "李鸿章在安徽佐福济，献策先取含山、巢县，克之，咸丰四年十二月始有知兵之名。"
  },
  {
   "段": "3.7",
   "事": "曾国藩以丁忧侍郎奉旨帮办团练，湘军起。"
  },
  {
   "段": "3.8",
   "事": "洪秀全据金陵后内部相残；金陵大营于咸丰六年、十年两次溃败，江浙沦陷。"
  },
  {
   "段": "3.8",
   "事": "英法联军入北京烧圆明园。"
  },
  {
   "段": "3.9",
   "事": "咸丰十年四月，曾国藩署两江总督并授钦差大臣，兵饷之权归一。"
  },
  {
   "段": "3.10",
   "事": "福济疏荐李鸿章为道员，遭郑魁士阻挠；李受谤几不能立足乡里。"
  },
  {
   "段": "3.10",
   "事": "咸丰八年李鸿章谒曾国藩于建昌，留其幕中。"
  },
  {
   "段": "3.10",
   "事": "咸丰九年五月李鸿章随曾国荃赴景德镇参赞军事。"
  },
  {
   "段": "3.10",
   "事": "咸丰十年曾国藩荐李鸿章为江北司道、两淮运使，均未成；李时年三十八。"
  },
  {
   "段": "4.4",
   "事": "咸丰十年，英法美等国改变方针，请为北京政府出兵助剿太平天国；俄公使伊格那面谒恭亲王表示愿派舰队助剿。"
  },
  {
   "段": "4.6",
   "事": "朝廷依曾国藩等的意见谢绝外国出兵，命曾国藩聘请外国军官训练新兵。"
  },
  {
   "段": "4.7",
   "事": "杨坊向吴煦推荐华尔，华尔募中外兵勇防卫苏沪，所部号称常胜军。"
  },
  {
   "段": "4.9",
   "事": "李秀成、李世贤分路攻掠江浙，杭州等地失陷，浙江巡抚王有龄死。"
  },
  {
   "段": "4.10",
   "事": "江苏绅士钱鼎铭到安庆向曾国藩求援。"
  },
  {
   "段": "4.11",
   "事": "曾国藩荐李鸿章为江苏统帅，李鸿章回庐州招募淮勇组建淮军。"
  },
  {
   "段": "4.12",
   "事": "同治元年三月，淮军乘上海官绅所雇轮船抵沪，李鸿章署理江苏巡抚。"
  },
  {
   "段": "4.14",
   "事": "淮军在南汇、川沙、徐家汇等地获胜，松江之围解除。"
  },
  {
   "段": "4.16",
   "事": "同治元年五月，曾国荃进屯金陵城外雨花台。"
  },
  {
   "段": "4.19",
   "事": "华尔攻慈溪中弹身亡，白齐文代领常胜军。"
  },
  {
   "段": "4.20",
   "事": "李秀成、李世贤率二十余万人围攻雨花台曾国荃大营，十月撤兵。"
  },
  {
   "段": "4.24",
   "事": "白齐文殴打杨坊、掠银四万两，李鸿章与英领事交涉将其黜退，改由戈登统领常胜军。"
  },
  {
   "段": "4.26",
   "事": "同治二年二三月，淮军与常胜军解常熟之围，攻克太仓、昆山。"
  },
  {
   "段": "4.28",
   "事": "淮军在北漍、南漍、麦市桥大破李秀成沿运河的连营。"
  },
  {
   "段": "4.32",
   "事": "李秀成夜出苏州，郜云官等刺杀谭绍洸开城投降。"
  },
  {
   "段": "4.36",
   "事": "李鸿章与程学启设宴诱杀八名降将，苏州平定，戈登因此大怒欲杀李鸿章。"
  },
  {
   "段": "4.41",
   "事": "同治三年二月，程学启攻嘉兴中弹，嘉兴攻克；三月程学启去世，左宗棠军入杭州。"
  },
  {
   "段": "4.44",
   "事": "同治三年四月六日，淮军攻克常州，擒陈坤书，江苏除金陵城外全部平定。"
  },
  {
   "段": "4.46",
   "事": "洪秀全服毒死，其子洪福被拥立；李鸿章托词不赴金陵会剿。"
  },
  {
   "段": "4.48",
   "事": "六月十六日曾军以地道炸塌金陵城墙攻入城中，李秀成赠马让幼主出逃，巷战后被擒。"
  },
  {
   "段": "4.50",
   "事": "朝廷论功行赏，曾国藩封侯，曾国荃、李鸿章封伯。"
  },
  {
   "段": "5.2",
   "事": "金陵克复后捻乱仍在；捻党咸丰三年起于皖北，咸丰七年冬游骑扰及直隶大名府，北京戒严。"
  },
  {
   "段": "5.4",
   "事": "庚申之役时捻党侵入山东，朝廷以僧格林沁督师追剿；同治二年发党余部合于捻。"
  },
  {
   "段": "5.4",
   "事": "同治三年九月捻党入湖北大掠，舒保战死，僧王之师屡溃。"
  },
  {
   "段": "5.5",
   "事": "同治四年四月二十五日僧格林沁在曹州中计败死；曾国藩受命为钦差大臣，李鸿章署理两江总督。"
  },
  {
   "段": "5.6",
   "事": "曾国藩定长围圈制之策，李鸿章承之。"
  },
  {
   "段": "5.7",
   "事": "同治五年十二月曾国藩以疾辞，李鸿章代为钦差大臣。"
  },
  {
   "段": "5.9",
   "事": "任柱、赖汶洸深入山东；李鸿章定先防运河、次扼胶莱之策，与丁宝桢多有龃龉。"
  },
  {
   "段": "5.9",
   "事": "七月王心安放敌偷渡潍河，胶莱防线溃；朝廷议罢运防，李鸿章坚持前议。"
  },
  {
   "段": "5.9",
   "事": "十月刘铭传在安邱、潍县之交获胜，二十四日在赣榆与善庆阵毙任柱。"
  },
  {
   "段": "5.10",
   "事": "十一月二十九日弥河之战，斩获近三万；十二月十一日吴毓兰生擒赖汶洸，东捻平。"
  },
  {
   "段": "5.11",
   "事": "同治七年正月西捻张总愚由山西渡河北窜，直逼畿辅，京师大震；李鸿章率军渡河进剿。"
  },
  {
   "段": "5.12",
   "事": "李鸿章奏请在河北推行坚壁清野、筑墟寨。"
  },
  {
   "段": "5.13",
   "事": "四月奏请刘铭传总统前敌各军，沿黄河、运河筑长墙浚壕，左宗棠亦派军策应。"
  },
  {
   "段": "5.14",
   "事": "李鸿章趁伏泛缩地围扎，以运河为外围、马颊河为里圈，层层逼敌。"
  },
  {
   "段": "5.14",
   "事": "六月二十八日刘铭传、郭松林合击于徒骇、黄、运之间，张总愚自沉于河，西捻平。"
  },
  {
   "段": "5.14",
   "事": "八月李鸿章入京觐见。"
  },
  {
   "段": "5.15",
   "事": "作者总评李鸿章用兵，认为其一生事业与精神皆得自曾国藩。"
  },
  {
   "段": "6.2",
   "事": "作者以“洋务”总括李鸿章中年二十余年事业，并列表其所办洋务。"
  },
  {
   "段": "6.3",
   "事": "作者归纳李鸿章洋务不出军事、商务两端，兴学堂、派留学也多为兵事与翻译。"
  },
  {
   "段": "6.4",
   "事": "列出中日战事前李鸿章手下海陆兵力（北洋海军表、水雷船、直隶淮军练勇表）。"
  },
  {
   "段": "6.9",
   "事": "直隶淮军练勇合计四十九营约二万五千人。"
  },
  {
   "段": "6.10",
   "事": "光绪八年法越肇衅时，李鸿章覆奏自信练军简器足以临敌。"
  },
  {
   "段": "6.10",
   "事": "中日战起，海军或创或夷、淮军屡败；残部再经联军津沽一役，随罗荣光、聂士成覆没。"
  },
  {
   "段": "6.11",
   "事": "作者分析其失败原因：群议掣肘、用人失当、见识不明。"
  },
  {
   "段": "6.12",
   "事": "作者指李鸿章所办商务无成效，归咎于官督商办。"
  },
  {
   "段": "6.14",
   "事": "引同治十一年五月李鸿章覆议制造轮船未可裁撤折，论三千余年一大变局。"
  },
  {
   "段": "6.16",
   "事": "引光绪元年因台湾事变筹画海防折，论数千年未有之变局与强敌。"
  },
  {
   "段": "6.20",
   "事": "作者评李鸿章知有兵事而不知有民政，为时势所造之英雄。"
  },
  {
   "段": "6.21",
   "事": "作者又为李鸿章辩护，指责者未必有资格。"
  },
  {
   "段": "6.22",
   "事": "作者宣告自此以后李鸿章失意之历史开始。"
  },
  {
   "段": "7.3",
   "事": "同治十一年日本问朝鲜事，中国答以不与闻；光绪元年日朝订约，承认朝鲜为自主之国。"
  },
  {
   "段": "7.3",
   "事": "光绪五年李鸿章密劝朝鲜与各国立约；光绪六年、八年何如璋、张佩纶主张主持朝鲜外交，李鸿章不从。"
  },
  {
   "段": "7.3",
   "事": "光绪十一年李鸿章与伊藤博文在天津订约，约定派兵须互相知照。"
  },
  {
   "段": "7.4",
   "事": "光绪二十年三月朝鲜东学党之乱，袁世凯请兵；五月初一李鸿章派舰、派叶志超赴牙山，并照会日本。"
  },
  {
   "段": "7.4",
   "事": "日本随即派兵，五月十五日到仁川者已五千；乱党解散后两国就撤兵与干预朝鲜内政僵持。"
  },
  {
   "段": "7.6",
   "事": "李鸿章与总理衙门寄望俄、英调停，迁延误时，五月下旬日兵在韩已万余。"
  },
  {
   "段": "7.7",
   "事": "六月李鸿章派卫汝贵、马玉崑等军入朝；二十五日日舰袭击，方伯谦驾济远逃回旅顺，高升被击沉。"
  },
  {
   "段": "7.7",
   "事": "六月二十九日牙山失守，叶志超退回平壤并捏报胜仗得赏。"
  },
  {
   "段": "7.8",
   "事": "八月十六日大东沟海战，致远邓世昌、经远林永升殉难，方伯谦撞沉扬威后逃，北洋失五舰而日舰无一沉没。"
  },
  {
   "段": "7.8",
   "事": "李鸿章电令将方伯谦军前正法。"
  },
  {
   "段": "7.9",
   "事": "聂士成先据平壤、南袭韩城之策，李鸿章不能用。"
  },
  {
   "段": "7.11",
   "事": "八月十五、十六日日军攻平壤，左宝贵战死，叶志超悬白旗，全军宵遁，平壤陷落。"
  },
  {
   "段": "7.14",
   "事": "平壤败后，依克唐阿、宋庆、吴大澂、刘坤一等先后受命统兵，号令不一。"
  },
  {
   "段": "7.19",
   "事": "九连城、金州、大连湾、旅顺口、威海卫、刘公岛等相继失守，丁汝昌以残舰降日，北洋海军覆没。"
  },
  {
   "段": "7.21",
   "事": "作者列李鸿章在此役中的十二条过错。"
  },
  {
   "段": "7.22",
   "事": "作者为海军与淮军部分辩护，认为全国军旅皆腐败，不能只归罪于李鸿章。"
  },
  {
   "段": "7.24",
   "事": "西报称日本实与李鸿章一人战；刘公岛降舰时有人求日军放还广丙，称此事与广东无涉。"
  },
  {
   "段": "7.25",
   "事": "李鸿章兵事声誉自此终结，外交困难开始。"
  },
  {
   "段": "8.3",
   "事": "同治九年天津民众杀教士、焚法国领事馆，法国联合英美施压，曾国藩镇压津民仍被攻击，崇厚奏请以李鸿章代之。"
  },
  {
   "段": "8.4",
   "事": "李鸿章任直隶总督时普法战争爆发，天津教案不了了之，李鸿章身价顿增。"
  },
  {
   "段": "8.5",
   "事": "光绪八年中法因安南开战，法水师提督格鲁比轰福州船厂，李鸿章令曾纪泽谋联英德牵制法国，法国议院否决增兵案，法人先请和。"
  },
  {
   "段": "8.6",
   "事": "朝鲜京城发生袭击日本使馆事件，伊藤博文来天津交涉，李鸿章傲然相待，双方订《天津条约》。"
  },
  {
   "段": "8.7",
   "事": "甲午冬中国求和，张荫桓、邵友濂被日本拒绝，改派李鸿章赴马关与伊藤博文、陆奥宗光开议。"
  },
  {
   "段": "8.7",
   "事": "日本提出以大沽、天津、山海关为质的停战条件，双方相持不下。"
  },
  {
   "段": "8.7",
   "事": "第三次会议后李鸿章归途遇刺，枪弹中左颧；日方慰问谢罪，允将停战节略画押。"
  },
  {
   "段": "8.8",
   "事": "朝廷派李经方为全权大臣，李鸿章仍带伤口授裁断。"
  },
  {
   "段": "8.8",
   "事": "三月初七伊藤交来和约底稿，李鸿章逐条驳议，双方往复修改。"
  },
  {
   "段": "8.8",
   "事": "李鸿章伤愈后至春帆楼面议，仅争得三年内还清免息及威海卫驻兵费减半。"
  },
  {
   "段": "8.9",
   "事": "书中录《马关条约》全文：朝鲜自主、割地、赔款、开埠、日军暂占威海卫等十一款，定于烟台换约。"
  },
  {
   "段": "8.21",
   "事": "作者评论此次议和李鸿章无功亦无罪，其误国在于前章所列失机诸事。"
  },
  {
   "段": "9.3",
   "事": "甲午战前中国求英俄调停；乙未三月李鸿章使日前与俄使喀希尼在俄使馆密议数日，俄方要求以军防和铁路利益为报酬。"
  },
  {
   "段": "9.4",
   "事": "张之洞电奏，主张与俄订密约助攻日本，许以新疆之地。"
  },
  {
   "段": "9.5",
   "事": "马关定约不到一月，俄国联德、法逼日本归还辽东，中国付三十兆两。"
  },
  {
   "段": "9.6",
   "事": "还辽后李鸿章罢职入阁；喀希尼要求改派李鸿章为贺俄皇加冕使，并贿通太后，太后召见李鸿章定联俄之谋。"
  },
  {
   "段": "9.7",
   "事": "丙申四月李鸿章在圣彼得堡开议，在莫斯科于加冕前将密约画押。"
  },
  {
   "段": "9.8",
   "事": "上海《字林西报》刊出密约原文，书中录其全文。"
  },
  {
   "段": "9.23",
   "事": "七月草约到京，皇上与总署坚拒；太后严责皇上，命督办军务处速办，九月三十日皇上挥泪批准。"
  },
  {
   "段": "9.24",
   "事": "李鸿章历聘欧洲议增进口税，俄允，德法观望英国，英相沙士勃雷婉拒，事未成。"
  },
  {
   "段": "9.25",
   "事": "李鸿章访俾斯麦、格莱斯顿，一无所购；八月自美洲归国，九月奉旨在总理衙门行走。"
  },
  {
   "段": "9.27",
   "事": "曹州教案后德国兵船闯入胶州湾，掳总兵章高元，迫中国租胶澳九十九年并让山东铁路矿务。"
  },
  {
   "段": "9.28",
   "事": "为提前还清日本赔款，俄英争相承借并提条件，总署被俄法胁迫一概回绝，终经赫德向汇丰、德华银行借款。"
  },
  {
   "段": "9.29",
   "事": "光绪二十四年初俄国索旅顺、大连，李鸿章与巴布罗福订约租借二十五年。"
  },
  {
   "段": "9.30",
   "事": "英国援例租借威海卫二十五年，英使斥退李鸿章的争辩。"
  },
  {
   "段": "9.31",
   "事": "法国强闯广州湾，随后租借九十九年。"
  },
  {
   "段": "9.32",
   "事": "四月十七日英国租借九龙九十九年，窦纳乐拍案拒绝不筑炮台之议。"
  },
  {
   "段": "9.33",
   "事": "芦汉铁路借款实权落入华俄银行，英国争牛庄铁路，英俄几乎开战。"
  },
  {
   "段": "9.33",
   "事": "七月二十四日皇上诏李鸿章毋庸在总理衙门行走，其外交官生涯结束。"
  },
  {
   "段": "9.35",
   "事": "作者评李鸿章外交专以联某国制某国，在中国为一流，置之世界则瞠乎其后。"
  },
  {
   "段": "10.2",
   "事": "作者说明李鸿章四十年仅有乙未至丙申、戊戌至庚子两段闲散时期，其间治河、治粤。"
  },
  {
   "段": "10.3",
   "事": "戊戌八月后政府派李鸿章治黄河，其奏议录比利时工程师卢法尔的勘河报告。"
  },
  {
   "段": "10.5",
   "事": "卢法尔报告雒口至盐窝的河身、民埝、大堤、险工状况，指出堤防无保护、多毁损。"
  },
  {
   "段": "10.10",
   "事": "报告叙述黄河尾闾三次改道（铁门关、韩家垣、丝网口）及新挑引河情形。"
  },
  {
   "段": "10.16",
   "事": "报告提出治河须察病原于上游，先测量全河、绘图、查验水性沙数，各省黄河统归一官节制。"
  },
  {
   "段": "10.19",
   "事": "报告建议沿河设电线、定守河章程、上游山地植树。"
  },
  {
   "段": "10.21",
   "事": "报告列出救急办法：培修堤岸、固筑险工、疏通尾闾，并讨论尾闾选址与减水坝。"
  },
  {
   "段": "10.24",
   "事": "李鸿章接李瀚章、谭钟鳞督粤，复就地正法之例严厉治盗，杀戮无算。"
  },
  {
   "段": "10.24",
   "事": "李鸿章以赌博承饷充缉捕经费，作者严厉批评。"
  },
  {
   "段": "10.25",
   "事": "李鸿章从黄遵宪之议拟在省城行警察法，未竟而去。"
  },
  {
   "段": "10.26",
   "事": "李鸿章对袒庇教民的牧师严明权限，此后无人再敢借教为奸。"
  },
  {
   "段": "10.27",
   "事": "李鸿章奉朝旨镇压康党，捕海外义民家属三人。"
  }
 ]
}