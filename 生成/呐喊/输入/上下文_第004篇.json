 "本篇事件（只用于判断位置，不能提前说）": [
  {
   "段": "4.1",
   "事": "方玄绰近来爱说“差不多”，用它来平息各种不平。"
  },
  {
   "段": "4.2",
   "事": "方玄绰在北京首善学校的讲堂上公开发表“差不多说”，说学生出身的官僚和老官僚差不多。"
  },
  {
   "段": "4.5",
   "事": "教员薪水被欠大半年，方玄绰靠官俸支持，不参加教员索薪。"
  },
  {
   "段": "4.6",
   "事": "听到“教员要钱不高尚”的说法，方玄绰当晚对太太发牢骚，太太说上月领的一成半薪水已用完。"
  },
  {
   "段": "4.10",
   "事": "教员在新华门前索薪被国军打伤后，政府发了一点薪水，方玄绰不费力领了钱。"
  },
  {
   "段": "4.13",
   "事": "政府连官吏也欠薪，官吏也开索薪大会，方玄绰赞成却仍不去讨债。"
  },
  {
   "段": "4.14",
   "事": "阴历五月初四午前，方太太把一叠账单塞给方玄绰，说要一百八十元才够开销。"
  },
  {
   "段": "4.16",
   "事": "方玄绰说索薪大会代表要求亲领支票，他不愿去，还说不做官了。"
  },
  {
   "段": "4.20",
   "事": "方太太提起学校催孩子学费，方玄绰发火，两人默默吃了午饭。"
  },
  {
   "段": "4.24",
   "事": "当晚方玄绰不到七点就回家，说银行已关门，要等初八才能领钱。"
  },
  {
   "段": "4.28",
   "事": "方玄绰说下午向金永生借五十元被拒。"
  },
  {
   "段": "4.30",
   "事": "方玄绰想起去年年关自己也借口没钱拒绝了借钱的同乡。"
  },
  {
   "段": "4.31",
   "事": "方玄绰叫小厮赊来一瓶莲花白，喝了酒，抽着香烟躺下看《尝试集》。"
  },
  {
   "段": "4.33",
   "事": "方太太问怎么对付店家，方玄绰叫她告诉店家初八下午再来。"
  },
  {
   "段": "4.37",
   "事": "方太太劝他另想办法，提到给书铺、报馆写稿，方玄绰一一否决，说过了节仍旧做官。"
  },
  {
   "段": "4.46",
   "事": "方太太提议去买彩票，被方玄绰斥为无教育。"
  },
  {
   "段": "4.48",
   "事": "方玄绰想起下午路过稻香村时见到头彩广告曾心动，因舍不得仅剩的六角钱而走开；随后又念起《尝试集》。"
  }
 ]
