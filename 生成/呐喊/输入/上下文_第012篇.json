  },
  {
   "段": "12.6",
   "事": "N描述北京双十节警察吩咐挂旗的情形。"
  },
  {
   "段": "12.9",
   "事": "N想起为革命奔走而死、坐牢、失踪的少年们。"
  },
  {
   "段": "12.14",
   "事": "N说最得意的是第一个双十节后不再因无辫被笑骂，谈起头发的历史。"
  },
  {
   "段": "12.19",
   "事": "N讲留学时剪辫，监督要停他官费，后来监督被邹容等人剪辫逃走。"
  },
  {
   "段": "12.21",
   "事": "N回国后买假辫子，被人看穿冷笑，后改穿西装、大衫，都被笑骂，用手杖打人才止。"
  },
  {
   "段": "12.25",
   "事": "N讲宣统初年做监学时因无辫被同事官僚排斥。"
  },
  {
   "段": "12.26",
   "事": "学生不听N劝阻剪了辫子；师范学堂六个学生剪辫被开除。"
  },
  {
   "段": "12.29",
   "事": "N说民国元年冬到北京后，骂他的人也被剪了辫子。"
  },
  {
   "段": "12.31",
   "事": "N反对女子剪发，引阿尔志跋绥夫的话发议论。"
  },
  {
