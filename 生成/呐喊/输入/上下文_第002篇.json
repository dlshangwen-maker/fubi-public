 "本篇事件（只用于判断位置，不能提前说）": [
  {
   "段": "2.1",
   "事": "“余”回乡探访生病的旧友，见到其兄，得知病者是弟弟、已病愈候补，得到日记二册，摘录一篇并写下小序。"
  },
  {
   "段": "2.4",
   "事": "狂人在月光下觉得精神爽快，又疑心赵家的狗看他两眼。"
  },
  {
   "段": "2.7",
   "事": "狂人出门，觉得赵贵翁、路人和小孩都用怪眼色看他，议论他。"
  },
  {
   "段": "2.13",
   "事": "街上一个女人打儿子说要咬几口，众人哄笑，陈老五把狂人拖回家，关进书房。"
  },
  {
   "段": "2.14",
   "事": "狂人回想前几天狼子村佃户对大哥说村里打死一个恶人、挖出心肝煎吃。"
  },
  {
   "段": "2.17",
   "事": "狂人夜里翻历史，从写满“仁义道德”的字缝里看出满本都是“吃人”二字。"
  },
  {
   "段": "2.19",
   "事": "陈老五送来蒸鱼，狂人觉得鱼眼像吃人的人，吃了几筷又吐出。"
  },
  {
   "段": "2.21",
   "事": "大哥请何先生来给狂人看脉，何先生让他静养；狂人放声大笑，又听见何先生对大哥说“赶紧吃罢”，认定大哥也合伙吃他。"
  },
  {
   "段": "2.26",
   "事": "狂人想到李时珍的书里写人肉可以煎吃，大哥讲书时说过“易子而食”“食肉寝皮”。"
  },
  {
   "段": "2.32",
   "事": "狂人认为众人布下罗网，想逼他自杀。"
  },
  {
   "段": "2.38",
   "事": "一个二十岁左右的人来，狂人追问吃人对不对，那人搪塞后说“从来如此”，随即不见。"
  },
  {
   "段": "2.53",
   "事": "清早狂人拦住大哥，劝他改掉吃人，列举易牙、徐锡林、狼子村、痨病人吃血等事。"
  },
  {
   "段": "2.58",
   "事": "赵贵翁等一伙人在门外探头探脑，大哥显出凶相，喝令“疯子有什么好看”。"
  },
  {
   "段": "2.62",
   "事": "狂人对众人喊“你们可以改了，从真心改起”，陈老五赶走众人，劝狂人回屋。"
  },
  {
   "段": "2.63",
   "事": "狂人在黑屋里觉得横梁和椽子压到身上，挣扎出来。"
  },
  {
   "段": "2.68",
   "事": "狂人想起五岁死去的妹子，认定是被大哥吃了，并回忆大哥讲过儿子要割肉给生病的父母吃。"
  },
  {
   "段": "2.73",
   "事": "狂人怀疑大哥把妹子的肉和在饭菜里，自己也无意中吃过。"
  },
  {
   "段": "2.77",
   "事": "狂人自问还有没有没吃过人的孩子，写下“救救孩子”。"
  }
 ]
