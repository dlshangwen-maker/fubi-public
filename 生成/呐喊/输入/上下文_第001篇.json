 "本篇事件（只用于判断位置，不能提前说）": [
  {
   "段": "1.1",
   "事": "叙述者来京城六年，说国家大事只增长了他看不起人的坏脾气，唯有一件小事使他忘记不得。"
  },
  {
   "段": "1.1",
   "事": "民国六年冬，大北风天，叙述者一早雇人力车去S门。"
  },
  {
   "段": "1.2",
   "事": "一个花白头发的老女人横穿马路，破棉背心兜住车把，慢慢倒地。"
  },
  {
   "段": "1.3",
   "事": "叙述者认为她没伤，叫车夫走自己的路。"
  },
  {
   "段": "1.4",
   "事": "车夫放下车子，扶老女人起来问她怎么了，老女人说摔坏了。"
  },
  {
   "段": "1.7",
   "事": "叙述者认为老女人装腔作势，车夫自讨苦吃。"
  },
  {
   "段": "1.8",
   "事": "车夫毫不踌躇，搀着老女人走向巡警分驻所。"
  },
  {
   "段": "1.9",
   "事": "叙述者觉得车夫满身灰尘的后影越来越高大，几乎成为一种威压。"
  },
  {
   "段": "1.11",
   "事": "巡警出来告诉叙述者自己雇车，车夫不能拉他了。"
  },
  {
   "段": "1.12",
   "事": "叙述者抓出一大把铜元托巡警交给车夫，随后自问这是什么意思而不能回答。"
  },
  {
   "段": "1.12",
   "事": "叙述者说几年来的文治武力早已忘却，唯有这件小事时时浮现，教他惭愧、催他自新。"
  }
 ]
