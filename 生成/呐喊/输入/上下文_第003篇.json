  {
   "段": "3.1",
   "事": "俄国盲诗人爱罗先珂到北京不久，向叙述者诉说寂寞。"
  },
  {
   "段": "3.3",
   "事": "冬末夏初的一个夜里，叙述者去仲密家访爱罗先珂，他怀念缅甸夏夜遍地的虫鸣。"
  },
  {
   "段": "3.6",
   "事": "爱罗先珂叹北京连蛙鸣也没有，叙述者说夏天大雨后沟里会有许多虾蟆叫。"
  },
  {
   "段": "3.7",
   "事": "几天后爱罗先珂买了十几个科斗，放进仲密挖的荷池里，常去看它们。"
  },
  {
   "段": "3.8",
   "事": "爱罗先珂劝仲密夫人养家畜，后来仲密家养了许多小鸡。"
  },
  {
   "段": "3.9",
   "事": "卖小鸡的乡下人带来小鸭，爱罗先珂觉得可爱，买了四个，每个八十文。"
  },
  {
   "段": "3.11",
   "事": "爱罗先珂去教书，四只小鸭跑进荷池，吃光了已经生脚的科斗。"
  },
  {
   "段": "3.12",
   "事": "傍晚爱罗先珂回来，最小的孩子和仲密夫人告诉他科斗被小鸭吃完了。"
  },
  {
   "段": "3.16",
   "事": "小鸭褪了黄毛时，爱罗先珂思念俄罗斯，匆匆去了赤塔。"
  },
  {
   "段": "3.17",
   "事": "到处有蛙鸣时小鸭已长大，两白两花，在积水的院子里游水，鸭鸭地叫。"
  },
  {
   "段": "3.18",
   "事": "到了冬初，爱罗先珂仍无消息，只有四只鸭还在叫。"
  }
