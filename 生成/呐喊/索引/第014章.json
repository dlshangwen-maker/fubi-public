 "事件": [
  {
   "段": "14.1",
   "事": "陈士成看县考榜，没有找到自己的名字。"
  },
  {
   "段": "14.2",
   "事": "他平日安排好的中举做官前程刹时倒塌。"
  },
  {
   "段": "14.4",
   "事": "回家后打发七个学童回去。"
  },
  {
   "段": "14.10",
   "事": "他计算连今年已考了十六回，想拿文章出门又缩回来。"
  },
  {
   "段": "14.14",
   "事": "夜里他听到“左弯右弯”的声音，想起祖母讲的祖宗埋银谜语。"
  },
  {
   "段": "14.20",
   "事": "他看见白光在房里东墙书桌下闪起。"
  },
  {
   "段": "14.23",
   "事": "他移开桌子掘地，掘出一个铜钱和破磁片。"
  },
  {
   "段": "14.25",
   "事": "他掘出一块下巴骨，仿佛听它说“这回又完了”，惊逃到院子。"
  },
  {
   "段": "14.27",
   "事": "他又听到“到山里去”，望见西高峰放出白光，奔出门去。"
  },
  {
   "段": "14.31",
   "事": "黎明时有人在西关门前喊“开城门来”。"
  },
  {
   "段": "14.32",
   "事": "第二天万流湖发现一具五十多岁的男浮尸，或说是陈士成，经相验后由地保埋了。"
  }
 ]
