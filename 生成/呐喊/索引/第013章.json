 "事件": [
  {
   "段": "13.1",
   "事": "深夜咸亨酒店里，老拱留意到隔壁单四嫂子家没有纺纱声。"
  },
  {
   "段": "13.7",
   "事": "单四嫂子抱着病重的宝儿坐在床沿，求签许愿吃单方都无效。"
  },
  {
   "段": "13.10",
   "事": "天亮宝儿鼻翼扇动，单四嫂子带着积蓄抱他去看何小仙。"
  },
  {
   "段": "13.12",
   "事": "何小仙说中焦塞着、火克金，开药方。"
  },
  {
   "段": "13.18",
   "事": "单四嫂子到济世老店买药，宝儿拔自己的头发。"
  },
  {
   "段": "13.20",
   "事": "回家路上蓝皮阿五抢着帮抱孩子，不久又还给她。"
  },
  {
   "段": "13.28",
   "事": "王九妈看宝儿，点头又摇头。"
  },
  {
   "段": "13.29",
   "事": "宝儿吃药后叫一声“妈”，下午死去。"
  },
  {
   "段": "13.30",
   "事": "邻人聚来，王九妈烧纸钱、借钱备饭。"
  },
  {
   "段": "13.31",
   "事": "咸亨掌柜作保为宝儿买棺木；夜里单四嫂子以为是梦。"
  },
  {
   "段": "13.35",
   "事": "第二天棺木送来，王九妈拖开单四嫂子盖棺，宝儿随葬玩具。"
  },
  {
   "段": "13.36",
   "事": "两名脚夫抬棺到义冢地。"
  },
  {
   "段": "13.38",
   "事": "单四嫂子夜里觉得屋子太静太大太空。"
  },
  {
   "段": "13.40",
   "事": "单四嫂子盼在梦里见宝儿，睡去；老拱和阿五醉着离开咸亨，鲁镇陷入寂静。"
  }
 ]
