# 复制成 deploy/.env 再改。不要把 .env 发给别人、不要传到网上（里面有密钥）。

# 管理员账号：只有用这些邮箱登录后，才能打开后台 http://服务器:8080/admin（看模型、队列、失败的任务、邀请码）。多个邮箱用逗号隔开。需要 FUBI_AUTH=1。
FUBI_ADMIN_EMAILS=dlshangwen@163.com

# ---- 模型（不填就是"假模型"：一切能用，只是导入的书没有解释和回顾）----
# OpenAI 兼容接口（DeepSeek、通义千问、Kimi、智谱、硅基流动、OpenAI……都是这一种）：
#FUBI_MODEL_PROVIDER=openai
#FUBI_MODEL_BASE_URL=https://api.deepseek.com
#FUBI_MODEL_API_KEY=sk-...
#FUBI_MODEL_NAME=deepseek-flash
#FUBI_MODEL_THINKING=disabled   # DeepSeek 的思考模式默认开启，会多收费；批量生成建议关闭
#FUBI_MODEL_EFFORT=low           # 想开着思考但便宜一点：删掉上一行（或改成 enabled），再用这一行。关闭思考时这行无效
#FUBI_MODEL_MAX_TOKENS=32000   # 单次回答长度上限（含思考内容），只按实际用量计费
#FUBI_MODEL_TIMEOUT=300        # 单次请求超时（秒）
# Anthropic：
#FUBI_MODEL_PROVIDER=anthropic
#FUBI_MODEL_API_KEY=sk-ant-...
#FUBI_MODEL_NAME=claude-sonnet-4-5

# 花费上限
FUBI_MODEL_DAILY_CALLS=2000
FUBI_MODEL_BOOK_CALLS=400
# 同时跑几个生成任务
FUBI_WORKERS=2
# 单个导入文件上限（MB）
FUBI_MAX_UPLOAD_MB=50

# ---- 告警（每 2 分钟本机巡检一次，出问题发邮件）----
# 收件人，多个用逗号隔开；不写就发给管理员邮箱。服务不通、磁盘快满、备份超过 30 小时没做、5 分钟内连续出错、模型额度用到 90% 都会发。
#FUBI_ALERT_TO=
#FUBI_ALERT_DISK_PCT=15
#FUBI_ALERT_5XX=5
